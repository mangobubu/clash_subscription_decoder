# =========================================================================
#                    Clash Subscription Proxy Customization
#                             Git Ignore System
# =========================================================================

# --- 敏感本地配置文件（绝对不能上传！） ---
backend/config.toml

# --- Go 后端临时产物 & 编译大二进制 ---
backend/tmp/
backend/*.exe
backend/server
backend/tmp.exe
backend/clash-proxy-backend

# --- 前端依赖与编译产物 ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# --- 后端静态资源打包产物（只保留编译占位符，忽略编译产生的大型资源） ---
backend/dist/*
!backend/dist/index.html

# --- 本地生产部署一站式打包产物 ---
/release/

# --- 运行日志 ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDE 开发者工具临时配置 ---
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
