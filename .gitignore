# --- 敏感本地配置文件（绝对不能上传！） ---
backend/config.toml

# --- Go 后端临时产物 & 编译大二进制 ---
backend/tmp/
backend/*.exe
backend/server
backend/tmp.exe

# --- 前端依赖与编译产物 ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# --- 运行日志 ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDE 开发者工具临时配置 ---
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
